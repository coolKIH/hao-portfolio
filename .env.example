# PostgreSQL connection string (Neon/Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Dev WebSocket access key — must match ACCESS_KEY in hao-portfolio-socket
NEXT_PUBLIC_SOCKET_ACCESS_KEY=your-dev-access-key

# Private draft notes — password for /notes/unlock (httpOnly cookie session)
# Leave unset to disable unlock (drafts stay hidden everywhere).
NOTES_PASSWORD=your-notes-password
# Optional; defaults to NOTES_PASSWORD if omitted. Prefer a long random string in production.
NOTES_SESSION_SECRET=your-long-random-session-secret
